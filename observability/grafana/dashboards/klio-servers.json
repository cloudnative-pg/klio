{
  "uid": "klio-servers",
  "title": "Klio Servers",
  "description": "Health, served clusters, Kopia snapshots and WAL processing of the Klio servers. Built from the Prometheus export of Klio's OpenTelemetry metrics.",
  "tags": [
    "klio",
    "postgresql",
    "backup"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "30s",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "text",
      "transparent": true,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "repeatDirection": "h",
      "options": {
        "mode": "markdown",
        "content": "*Server namespace* is where the Klio server runs, not where the clusters it backs run. *Server* selects one or more Klio servers. *Served cluster* lists the clusters backed by the selected servers, from any namespace."
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Server health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "text",
      "transparent": true,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "repeatDirection": "h",
      "options": {
        "mode": "markdown",
        "content": "Uptime of each Klio server and the messages waiting in its embedded queue."
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (service_name) (klio_server_uptime_seconds{service_name=~\"$server\"})",
          "instant": false,
          "legendFormat": "{{service_name}}",
          "range": true
        }
      ],
      "title": "Server uptime",
      "description": "Time since the Klio server process started, per server. A sudden drop means that server's StatefulSet restarted.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "text": {
          "titleSize": 14,
          "valueSize": 28
        },
        "percentChangeColorMode": "standard",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdhms",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service_name, stream) (klio_server_queue_messages{service_name=~\"$server\"})",
          "instant": false,
          "legendFormat": "{{service_name}} / {{stream}}",
          "range": true
        }
      ],
      "title": "Queue size (messages)",
      "description": "Messages currently held in each NATS JetStream stream of the embedded queue, per server.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "gradientMode": "opacity",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service_name, stream) (klio_server_queue_bytes{service_name=~\"$server\"})",
          "instant": false,
          "legendFormat": "{{service_name}} / {{stream}}",
          "range": true
        }
      ],
      "title": "Queue size (bytes)",
      "description": "Bytes currently held in each NATS JetStream stream of the embedded queue, per server.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "gradientMode": "opacity",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Served clusters",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "text",
      "transparent": true,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "repeatDirection": "h",
      "options": {
        "mode": "markdown",
        "content": "Backups and WAL of the clusters backed by the selected servers."
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster_name, tier) (klio_server_backup_backups{service_name=~\"$server\",cluster_name=~\"$cluster\"})",
          "instant": false,
          "legendFormat": "{{cluster_name}} {{tier}}",
          "range": true
        }
      ],
      "title": "Retained backups",
      "description": "Number of PostgreSQL backups currently retained per cluster and tier.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 14
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "text": {
          "titleSize": 14,
          "valueSize": 28
        },
        "percentChangeColorMode": "standard",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max by (cluster_name, tier) (klio_server_backup_latest_backup_completion_time_seconds{service_name=~\"$server\",cluster_name=~\"$cluster\"})",
          "instant": false,
          "legendFormat": "{{cluster_name}} {{tier}}",
          "range": true
        }
      ],
      "title": "Latest backup age (completion)",
      "description": "Elapsed time since the most recently retained PostgreSQL backup completed, per cluster and tier.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 14
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "text": {
          "titleSize": 14,
          "valueSize": 28
        },
        "percentChangeColorMode": "standard",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdhms",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max by (cluster_name, tier) (klio_server_wal_latest_written_time_seconds{service_name=~\"$server\",cluster_name=~\"$cluster\"})",
          "instant": false,
          "legendFormat": "{{cluster_name}} {{tier}}",
          "range": true
        }
      ],
      "title": "Time since last WAL written",
      "description": "Elapsed time since the server last wrote a WAL file for each cluster and tier.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 14
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "custom": {
            "gradientMode": "opacity",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster_name, tier) (rate(klio_server_wal_written_size_bytes_total{service_name=~\"$server\",cluster_name=~\"$cluster\"}[$__rate_interval]))",
          "instant": false,
          "legendFormat": "{{cluster_name}} {{tier}}",
          "range": true
        }
      ],
      "title": "WAL bytes written (rate)",
      "description": "Rate of WAL bytes written by the server, split by cluster and storage tier.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 14
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "custom": {
            "gradientMode": "opacity",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Kopia snapshots",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "text",
      "transparent": true,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "repeatDirection": "h",
      "options": {
        "mode": "markdown",
        "content": "Base backup snapshots stored in the Kopia repository of each tier."
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, tier) (label_replace(klio_server_backup_snapshots{service_name=~\"$server\",snapshot_source=~\"[^@]*@$cluster:.*\"}, \"cluster\", \"$1\", \"snapshot_source\", \"[^@]*@([^:]+):.*\"))",
          "instant": false,
          "legendFormat": "{{cluster}} {{tier}}",
          "range": true
        }
      ],
      "title": "Retained snapshots",
      "description": "Total kopia snapshots currently retained per cluster and tier.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 0,
        "y": 25
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "text": {
          "titleSize": 14,
          "valueSize": 28
        },
        "percentChangeColorMode": "standard",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (cluster, tier) (label_replace(klio_server_backup_latest_snapshot_size_bytes{service_name=~\"$server\",snapshot_source=~\"[^@]*@$cluster:.*\"}, \"cluster\", \"$1\", \"snapshot_source\", \"[^@]*@([^:]+):.*\"))",
          "instant": false,
          "legendFormat": "{{cluster}} {{tier}}",
          "range": true
        }
      ],
      "title": "Latest snapshot size",
      "description": "Size of the most recent base backup snapshot on Kopia, not accounting for deduplication.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 4,
        "y": 25
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "text": {
          "titleSize": 14,
          "valueSize": 28
        },
        "percentChangeColorMode": "standard",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (cluster, tier) (label_replace(klio_server_backup_latest_snapshot_files{service_name=~\"$server\",snapshot_source=~\"[^@]*@$cluster:.*\"}, \"cluster\", \"$1\", \"snapshot_source\", \"[^@]*@([^:]+):.*\"))",
          "instant": false,
          "legendFormat": "{{cluster}} {{tier}}",
          "range": true
        }
      ],
      "title": "Latest snapshot files",
      "description": "Number of files in the most recent base backup snapshot on Kopia.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 25
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "text": {
          "titleSize": 14,
          "valueSize": 28
        },
        "percentChangeColorMode": "standard",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (cluster, tier) (label_replace(klio_server_backup_latest_snapshot_dirs{service_name=~\"$server\",snapshot_source=~\"[^@]*@$cluster:.*\"}, \"cluster\", \"$1\", \"snapshot_source\", \"[^@]*@([^:]+):.*\"))",
          "instant": false,
          "legendFormat": "{{cluster}} {{tier}}",
          "range": true
        }
      ],
      "title": "Latest snapshot dirs",
      "description": "Number of directories in the most recent base backup snapshot on Kopia.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 12,
        "y": 25
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "text": {
          "titleSize": 14,
          "valueSize": 28
        },
        "percentChangeColorMode": "standard",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max by (cluster, tier) (label_replace(klio_server_backup_latest_snapshot_timestamp_seconds{service_name=~\"$server\",snapshot_source=~\"[^@]*@$cluster:.*\"}, \"cluster\", \"$1\", \"snapshot_source\", \"[^@]*@([^:]+):.*\"))",
          "instant": false,
          "legendFormat": "{{cluster}} {{tier}}",
          "range": true
        }
      ],
      "title": "Latest snapshot age",
      "description": "Age of the most recent base backup snapshot on Kopia, per cluster and tier.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 16,
        "y": 25
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "text": {
          "titleSize": 14,
          "valueSize": 28
        },
        "percentChangeColorMode": "standard",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdhms",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - min by (cluster, tier) (label_replace(klio_server_backup_oldest_snapshot_timestamp_seconds{service_name=~\"$server\",snapshot_source=~\"[^@]*@$cluster:.*\"}, \"cluster\", \"$1\", \"snapshot_source\", \"[^@]*@([^:]+):.*\"))",
          "instant": false,
          "legendFormat": "{{cluster}} {{tier}}",
          "range": true
        }
      ],
      "title": "Oldest snapshot age",
      "description": "Age of the oldest retained base backup snapshot on Kopia, per cluster and tier.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 25
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "text": {
          "titleSize": 14,
          "valueSize": 28
        },
        "percentChangeColorMode": "standard",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdhms",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "WAL processing",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "text",
      "transparent": true,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "repeatDirection": "h",
      "options": {
        "mode": "markdown",
        "content": "Latency of the WAL operations on the server, aggregated across the selected served clusters."
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.50, sum by (le, path, stage) (rate(klio_server_wal_block_duration_nanoseconds_bucket{service_name=~\"$server\",cluster_name=~\"$cluster\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "{{path}}/{{stage}} p50",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.90, sum by (le, path, stage) (rate(klio_server_wal_block_duration_nanoseconds_bucket{service_name=~\"$server\",cluster_name=~\"$cluster\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "{{path}}/{{stage}} p90",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, path, stage) (rate(klio_server_wal_block_duration_nanoseconds_bucket{service_name=~\"$server\",cluster_name=~\"$cluster\"}[$__rate_interval])))",
          "instant": false,
          "legendFormat": "{{path}}/{{stage}} p99",
          "range": true
        }
