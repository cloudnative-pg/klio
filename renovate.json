{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":gitSignOff",
    ":semanticCommitType(chore)",
    ":labels(automated,no-issue)",
    "customManagers:githubActionsVersions",
    ":automergeMinor",
    ":automergeDigest",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "enabled": true,
  "prConcurrentLimit": 5,
  "gomod": {
    "ignorePaths": [
      "**/dagger/**"
    ]
  },
  "kustomize": {
    "ignorePaths": [
      "core/kubernetes/klio/overlays/**/kustomization.yaml"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "semanticCommits": "enabled",
  "commitBodyTable": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "Taskfile.yml",
        "documentation/crd-gen-refs/config.yaml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: currentValue=(?<currentValue>[^\\s]+?))?\\s+[A-Za-z0-9_]+?_SHA\\s*:\\s*[\"']?(?<currentDigest>[a-f0-9]+?)[\"']?\\s",
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+[^:]+\\s*:\\s*[\"']?(?<currentValue>.+?)[\"']?\\s"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "*/dagger/*/main.go",
        "*/docker-bake.hcl"
      ],
      "matchStrings": [
        "\\/\\/ renovate image: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+[^=]+=\\s*[\"']?[^:]+:(?<currentValue>[^@]+?)(@(?<currentDigest>sha256:[a-f0-9]+))?[\"']\\s",
        "\\/\\/ renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+\\/\\/\\s+\\+default=[\"']?(?<currentValue>.+?)[\"']?\\s"
      ]
    }
  ],
  "customDatasources": {
    "envtest": {
      "format": "yaml",
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/kubernetes-sigs/controller-tools/master/envtest-releases.yaml",
      "transformTemplates": [
        "{\"releases\": $sort($keys(releases)[$ ~> /^v\\d+\\.\\d+\\.\\d+$/]).{\"version\": $}}"
      ]
    }
  },
  "packageRules": [
    {
      "matchDatasources": [
        "go"
      ],
      "matchPackageNames": [
        "github.com/leonardoce/kopia",
        "github.com/leonardoce/afero-s3"
      ],
      "enabled": false,
      "description": "These packages are replaced with forks - updates are ignored"
    },
    {
      "matchDatasources": [
        "go"
      ],
      "matchPackageNames": [
        "!/k8s.io/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "all non-major go dependencies"
    },
    {
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "https://github.com/cloudnative-pg/daggerverse"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "all cloudnative-pg daggerverse dependencies"
    },
    {
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "https://github.com/sagikazarmark/daggerverse"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "all sagikazarmark daggerverse dependencies"
    },
    {
      "matchDatasources": [
        "go"
      ],
      "matchPackageNames": [
        "github.com/kopia/kopia"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "all kopia api"
    },
    {
      "matchFileNames": [
        "documentation/web/package.json",
        "documentation/web/yarn.lock"
      ],
      "groupName": "documentation dependencies"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/"
    }
  ]
}
