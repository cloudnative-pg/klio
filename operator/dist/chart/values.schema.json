{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "certmanager": {
      "properties": {
        "clusterDomain": {
          "default": "cluster.local",
          "description": "The DNS domain of the cluster",
          "type": "string"
        },
        "createMetricsCertificate": {
          "default": true,
          "description": "Create certificates for the metrics service.",
          "type": "boolean"
        },
        "createPluginClientCertificate": {
          "default": true,
          "description": "Create certificates for the plugin client.",
          "type": "boolean"
        },
        "createPluginServerCertificate": {
          "default": true,
          "description": "Create certificates for the plugin server.",
          "type": "boolean"
        },
        "duration": {
          "default": "2160h",
          "description": "The duration of the certificates.",
          "type": "string"
        },
        "enable": {
          "default": true,
          "description": "Enable cert-manager integration for certificate creation.",
          "type": "boolean"
        },
        "renewBefore": {
          "default": "360h",
          "description": "The renew before time for the certificates.",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "controllerManager": {
      "properties": {
        "affinity": {
          "additionalProperties": true,
          "description": "Affinity rules for the operator deployment.",
          "required": [],
          "type": "object"
        },
        "manager": {
          "properties": {
            "args": {
              "description": "List of command line arguments to pass to the controller manager.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "containerSecurityContext": {
              "description": "The security context for the controller manager container.",
              "properties": {
                "allowPrivilegeEscalation": {
                  "default": false,
                  "type": "boolean"
                },
                "capabilities": {
                  "properties": {
                    "drop": {
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          }
                        ],
                        "required": []
                      },
                      "type": "array"
                    }
                  },
                  "required": [],
                  "type": "object"
                }
              },
              "required": [],
              "type": "object"
            },
            "env": {
              "additionalProperties": true,
              "description": "The environment variables to set in the controller manager container.\nSet OTEL_* variables here to enable OpenTelemetry export.\nSee the OpenTelemetry Observability page in the documentation.",
              "properties": {
                "SIDECAR_IMAGE": {
                  "default": "ghcr.io/cloudnative-pg/klio:v0.0.21",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "image": {
              "properties": {
                "pullPolicy": {
                  "default": "Always",
                  "description": "The controller manager container imagePullPolicy.",
                  "type": "string"
                },
                "pullSecrets": {
                  "description": "The list of imagePullSecrets.",
                  "items": {
                    "required": []
                  },
                  "type": "array"
                },
                "repository": {
                  "default": "ghcr.io/cloudnative-pg/klio-operator",
                  "description": "The image to use for the controller manager container.",
                  "type": "string"
                },
                "tag": {
                  "default": "v0.0.21",
                  "description": "The tag to use for the controller manager container image.",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            "livenessProbe": {
              "description": "Liveness probe configuration.",
              "properties": {
                "httpGet": {
                  "properties": {
                    "path": {
                      "default": "/healthz",
                      "type": "string"
                    },
                    "port": {
                      "default": 8081,
                      "type": "integer"
                    }
                  },
                  "required": [],
                  "type": "object"
                },
                "initialDelaySeconds": {
                  "default": 15,
                  "type": "integer"
                },
                "periodSeconds": {
                  "default": 20,
                  "type": "integer"
                }
              },
              "required": [],
              "type": "object"
            },
            "readinessProbe": {
              "description": "Readiness probe configuration.",
              "properties": {
                "httpGet": {
                  "properties": {
                    "path": {
                      "default": "/readyz",
                      "type": "string"
                    },
                    "port": {
                      "default": 8081,
                      "type": "integer"
                    }
                  },
                  "required": [],
                  "type": "object"
                },
                "initialDelaySeconds": {
                  "default": 5,
                  "type": "integer"
                },
                "periodSeconds": {
                  "default": 10,
                  "type": "integer"
                }
              },
              "required": [],
              "type": "object"
            },
            "resources": {
              "description": "The resources to allocate.",
              "properties": {
                "limits": {
                  "properties": {
                    "cpu": {
                      "default": "500m",
                      "type": "string"
                    },
                    "memory": {
                      "default": "128Mi",
                      "type": "string"
                    }
                  },
                  "required": [],
                  "type": "object"
                },
                "requests": {
                  "properties": {
                    "cpu": {
                      "default": "10m",
                      "type": "string"
                    },
                    "memory": {
                      "default": "64Mi",
                      "type": "string"
                    }
                  },
                  "required": [],
                  "type": "object"
                }
              },
              "required": [],
              "type": "object"
            }
          },
          "required": [],
          "type": "object"
        },
        "nodeSelector": {
          "additionalProperties": true,
          "description": "NodeSelector for the operator deployment.",
          "required": [],
          "type": "object"
        },
        "podSecurityContext": {
          "description": "The security context for the controller manager pod.",
          "properties": {
            "runAsNonRoot": {
              "default": true,
              "type": "boolean"
            },
            "seccompProfile": {
              "properties": {
                "type": {
                  "default": "RuntimeDefault",
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            }
          },
          "required": [],
          "type": "object"
        },
        "priorityClassName": {
          "default": "",
          "description": "Priority class name for the controller manager pod.",
          "type": "string"
        },
        "serviceAccount": {
          "properties": {
            "annotations": {
              "additionalProperties": true,
              "description": "The annotations to add to the service account.",
              "required": [],
              "type": "object"
            }
          },
          "required": [],
          "type": "object"
        },
        "tolerations": {
          "description": "Tolerations for the operator deployment.",
          "items": {
            "required": []
          },
          "type": "array"
        },
        "topologySpreadConstraints": {
          "description": "Topology Spread Constraints for the operator deployment.",
          "items": {
            "required": []
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "fullnameOverride": {
      "default": "",
      "description": "Override the fully qualified name of the Helm Chart.",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "type": "object"
    },
    "kubernetesClusterDomain": {
      "default": "cluster.local",
      "description": "The domain for the Kubernetes cluster.",
      "type": "string"
    },
    "metricsService": {
      "properties": {
        "enable": {
          "default": true,
          "description": "Enable the metrics service for the controller manager.",
          "type": "boolean"
        },
        "metricsServiceSecret": {
          "default": "klio-metrics-server-cert",
          "description": "The name of the secret containing the TLS certificate for the metrics service.",
          "type": "string"
        },
        "ports": {
          "description": "The port the metrics service will listen on.",
          "items": {
            "anyOf": [
              {
                "properties": {
                  "name": {
                    "default": "https",
                    "type": "string"
                  },
                  "port": {
                    "default": 8443,
                    "type": "integer"
                  },
                  "protocol": {
                    "default": "TCP",
                    "type": "string"
                  },
                  "targetPort": {
                    "default": 8443,
                    "type": "integer"
                  }
                },
                "required": [],
                "type": "object"
              }
            ],
            "required": []
          },
          "type": "array"
        },
        "type": {
          "default": "ClusterIP",
          "description": "Service type for the metrics service.",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "nameOverride": {
      "default": "klio",
      "description": "Override the name of the Helm Chart.",
      "type": "string"
    },
    "plugin": {
      "properties": {
        "clientSecret": {
          "default": "klio-plugin-client-tls",
          "description": "The Client TLS certificate.",
          "type": "string"
        },
        "name": {
          "default": "klio.cnpg.io",
          "description": "The name the plugin will use to register itself with the CNPG Operator.",
          "type": "string"
        },
        "port": {
          "default": 9090,
          "description": "The port the plugin will listen on. It must match the \"--plugin-server-address\" argument.",
          "type": "integer"
        },
        "serverSecret": {
          "default": "klio-plugin-server-tls",
          "description": "The Server TLS certificate.",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "prometheus": {
      "properties": {
        "enable": {
          "default": true,
          "description": "To enable a ServiceMonitor to export metrics to Prometheus set true.",
          "type": "boolean"
        }
      },
      "required": [],
      "type": "object"
    },
    "serviceAccount": {
      "properties": {
        "annotations": {
          "additionalProperties": true,
          "description": "The annotations to add to the service account.",
          "required": [],
          "type": "object"
        },
        "automount": {
          "default": true,
          "description": "Automount service account token.",
          "type": "boolean"
        },
        "create": {
          "default": true,
          "description": "Specifies whether a service account should be created.",
          "type": "boolean"
        },
        "name": {
          "default": "",
          "description": "The name of the service account",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  "required": [],
  "type": "object"
}
